  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.6.5"
